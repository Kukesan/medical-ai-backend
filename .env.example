APP_NAME=Yarlit Medical AI Backend
# Set APP_ENV=prod in production: hides /docs and refuses to start with weak JWT secrets or wildcard CORS.
APP_ENV=dev
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# Comma-separated frontend origins allowed by CORS (production: your https site URL).
CORS_ORIGINS=http://localhost:5173
# Proxies trusted for X-Forwarded-For (real client IP for rate limiting). Use * on Railway.
FORWARDED_ALLOW_IPS=127.0.0.1

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/yarlit_medical_ai

# Production: two different random values, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET_KEY=change-me
JWT_REFRESH_SECRET_KEY=change-me-too
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Users must re-enter their password at least this often, however often the app refreshes.
SESSION_MAX_AGE_DAYS=30

# Shared with the ocr-extractor worker, which calls POST /documents/{id}/extract with it.
INTERNAL_SERVICE_API_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

LOCAL_STORAGE_DIR=storage
MAX_UPLOAD_SIZE_MB=25
RATE_LIMIT=100/minute

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
PRESIGNED_URL_EXPIRE_SECONDS=900

GOOGLE_PLACES_API_KEY=